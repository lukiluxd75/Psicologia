# ====================================================================
# Configuración del Backend - Corrector Psicométrico AI (AUDIT, BRIEF, PASS)
# ====================================================================

# 1. Google Gemini AI API Key (Obligatorio para OCR de hojas físicas)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui

# 2. Google Sheets Spreadsheet ID (Opcional pero recomendado para persistencia en la nube)
# El ID se encuentra en la URL de tu hoja de cálculo:
# https://docs.google.com/spreadsheets/d/<ESTE_ES_EL_SPREADSHEET_ID>/edit
SPREADSHEET_ID=tu_spreadsheet_id_aqui

# 3. Credenciales de Cuenta de Servicio Google (Opcional para despliegue sin archivos)
# Puedes pegar el contenido completo del JSON de la cuenta de servicio como una sola línea:
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
# O colocar el archivo credentials.json en la raíz del backend.

# 4. Puerto de ejecución (Establecido automáticamente en plataformas cloud como Railway/Render)
PORT=8000
