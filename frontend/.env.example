# URL del Backend FastAPI
# - Si despliegas frontend y backend desacoplados (ej. Vercel + Railway):
#   Establece la URL pública del backend (sin barra final):
#   VITE_API_URL=https://tu-backend-api.railway.app
#
# - Si despliegas con servidor unificado o en desarrollo local (Vite proxy):
#   Déjalo vacío o no lo definas, el proxy o mismo origen manejarán /api
VITE_API_URL=
